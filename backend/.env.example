NODE_ENV=development
PORT=3001

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# AWS S3 (used to presign uploads for the generated post images).
# Optional at boot — only required when POST /uploads/presign is called.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=trabalharn
