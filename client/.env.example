# Base URL of the backend API, used for server-side requests (job openings, etc).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional. Instagram handle shown across the landing page. Defaults to @trabalharn.
NEXT_PUBLIC_INSTAGRAM_HANDLE=@trabalharn

# Optional. Leave empty to hide the WhatsApp/e-mail contact channels instead of
# showing a placeholder.
CONTACT_WHATSAPP_NUMBER=
CONTACT_EMAIL=
