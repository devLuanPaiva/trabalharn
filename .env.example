# Used by docker-compose.yml (n8n)
N8N_PORT=5679
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5679/
GENERIC_TIMEZONE=America/Fortaleza

# Optional but recommended: keeps credentials decryptable across container
# recreations. Leave empty to let n8n generate and persist its own key.
N8N_ENCRYPTION_KEY=

# Reachable from inside the n8n container as {{$env.BACKEND_API_URL}}.
# The backend runs on the host (pnpm start:dev), not inside Docker.
BACKEND_API_URL=http://host.docker.internal:3001
